# Base de datos - Supabase PostgreSQL
# Pooler (puerto 6543): la usa la app en runtime (lib/db.ts, driver adapter @prisma/adapter-pg).
DATABASE_URL="postgresql://postgres.[TU-PROYECTO]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Conexión directa (puerto 5432): la usa la CLI de Prisma (prisma.config.ts: migraciones / seed).
DIRECT_URL="postgresql://postgres.[TU-PROYECTO]:[PASSWORD]@db.[TU-PROYECTO].supabase.co:5432/postgres"

# Firma HMAC de la cookie de sesión (features/auth/session-cookie.ts)
SESSION_SECRET="genera-un-secreto-largo-y-aleatorio-aqui"

# Catálogo global de ejercicios (proyecto hermano exercise-catalog, deployado en Vercel).
# CATALOG_API_URL es base tanto para los endpoints /api/* como para el media (gifUrl/image
# vienen como paths relativos, ej. videos/0001-xxx.gif).
CATALOG_API_URL="https://exercise-catalog-coral.vercel.app"
CATALOG_API_KEY="pedila-al-admin-del-proyecto-exercise-catalog"

# Storage de media para ejercicios propios (Supabase Storage, bucket PÚBLICO).
# La clave es la service role (o su equivalente sb_secret_): solo se usa server-side
# (features/admin/catalogo/storage.ts) — nunca exponerla al cliente.
SUPABASE_URL="https://[TU-PROYECTO].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
SUPABASE_STORAGE_BUCKET="fitnessar-media"
